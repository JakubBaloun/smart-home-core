meta {
  name: Get Telemetry History
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/telemetry/{{deviceName}}?field=humidity&from=2026-01-01T00:00:00Z&to=2026-12-31T23:59:59Z
  body: none
  auth: none
}

params:query {
  field: humidity
  from: 2026-01-01T00:00:00Z
  to: 2026-12-31T23:59:59Z
}
